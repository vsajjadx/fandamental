# Copy to .env and edit. Never commit .env.

# Public domain of the bridge (Caddy gets a free HTTPS certificate for it automatically)
FA_DOMAIN=bridge.example.com

# SQLite database file (inside the container it lives on the "data" volume)
FA_DB_PATH=/data/fandamental.db

# The web app origin(s) allowed to call the API from the browser (comma separated, no trailing slash)
# e.g. GitHub Pages: https://vsajjadx.github.io   local: http://localhost:8080
FA_ALLOWED_ORIGINS=https://vsajjadx.github.io,http://localhost:8080

# Refuse plain HTTP (except localhost). Keep 1 in production.
FA_REQUIRE_HTTPS=1
# Behind Caddy/Nginx you control: trust X-Forwarded-Proto
FA_TRUST_PROXY=1

# Signal freshness / validity (seconds)
FA_SIGNAL_MAX_AGE_SEC=900
FA_SIGNAL_DEFAULT_TTL_SEC=900
# Terminal shown as disconnected after this much silence
FA_HEARTBEAT_TIMEOUT_SEC=60
# A "sending" order with no result after this becomes "unknown" (reconciled, never re-sent)
FA_SENDING_TIMEOUT_SEC=120
FA_RATE_LIMIT_PER_MIN=240
FA_LOG_LEVEL=INFO
